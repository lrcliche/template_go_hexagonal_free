APP_ENV=development
HTTP_PORT=8080
READ_TIMEOUT_SECONDS=10
WRITE_TIMEOUT_SECONDS=10

# DSN currently used by config loader
POSTGRES_DSN=postgres://postgres:postgres@localhost:5432/template_hexagonal?sslmode=disable

# Expanded DB settings for future CI/runtime integration
APP_PORT=8080
DB_HOST=localhost
DB_PORT=5432
DB_NAME=template_hexagonal
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSLMODE=disable
